# Environment variables for Hippo Build X
# Copy to `.env` and `apps/web/.env.local` as needed.

# PostgreSQL / Neon
# Production runtime credentials must be NOSUPERUSER NOBYPASSRLS. Do not use
# the Neon owner/admin connection for normal web or worker traffic.
DATABASE_URL=postgres://hippo_runtime:change-me@localhost:5432/hippo

# Redis (BullMQ) — Redis 7+ required for async worker provisioning
REDIS_URL=redis://localhost:6379

# Set only for local development or CI when no worker process is running.
# Never use synchronous provisioning as the normal production topology.
PROVISION_SYNC=false

# Auth
JWT_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
COOKIE_SECURE=false

# Tenant channel credential envelope
# Required in production; use a secret manager and rotate with the version field.
CHANNEL_CONFIG_KEY=dev-channel-config-key-change-me!!
CHANNEL_CONFIG_KEY_VERSION=v1

# Bootstrap/service access. Platform users should use platform login after Phase 1.
PLATFORM_API_KEY=dev-platform-api-key-change-me
# PLATFORM_API_KEY_REQUIRED=true

# Runtime
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
