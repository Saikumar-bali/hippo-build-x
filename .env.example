# Environment variables for Hippo Build X
# Copy to `.env` and `apps/web/.env.local` as needed.

# Restricted application connection: NOSUPERUSER, NOBYPASSRLS, no schema DDL.
DATABASE_URL=postgres://hippo_runtime:change-me@localhost:5432/hippo
DATABASE_RUNTIME_ROLE=hippo_runtime

# Operator connection: deployment migrations and tenant provisioning only.
# Required by production workers; never expose it to browser/client code.
MIGRATION_DATABASE_URL=postgres://hippo_migrator:change-me@localhost:5432/hippo

# Redis (BullMQ) — Redis 7+ required for async worker provisioning.
REDIS_URL=redis://localhost:6379

# Local/CI only when no worker process is running.
PROVISION_SYNC=false

# Auth
JWT_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
COOKIE_SECURE=false

# Tenant channel credential encryption.
CHANNEL_CONFIG_KEY_VERSION=v1
CHANNEL_CONFIG_KEY=dev-channel-config-key-change-me!!
# Production rotation example: retain old versions until every row is re-encrypted.
# CHANNEL_CONFIG_KEYS={"v1":"old-secret-at-least-24-characters","v2":"current-secret-at-least-24-characters"}

# Bootstrap/service access. Prefer platform-user login after Phase 1.
PLATFORM_API_KEY=dev-platform-api-key-change-me
# PLATFORM_API_KEY_REQUIRED=true

NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
