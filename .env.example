# Environment variables for Hippo Build X
# Copy to `.env` and `apps/web/.env.local` as needed.

# PostgreSQL (Neon-compatible)
DATABASE_URL=postgres://hippo:hippo@localhost:5432/hippo

# Redis (BullMQ) — Redis 7+ required for async worker path
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
COOKIE_SECURE=false

# Tenant admin secrets
CHANNEL_CONFIG_KEY=dev-channel-config-key-change-me!!
PLATFORM_API_KEY=dev-platform-api-key-change-me
# PLATFORM_API_KEY_REQUIRED=true

# Runtime
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
