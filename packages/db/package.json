{
  "name": "@hippo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./schema": "./src/schema/index.js",
    "./migrations": "./src/migrations/index.js"
  },
  "scripts": {
    "lint": "eslint src",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:control": "node src/scripts/migrate-control.js",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node src/scripts/seed.js"
  },
  "dependencies": {
    "@hippo/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.17.0",
    "vitest": "^2.1.8"
  }
}
