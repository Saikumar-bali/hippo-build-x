{
  "name": "@hippo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "node --watch src/main.js",
    "start": "node src/main.js",
    "start:prod": "node src/main.js",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.config.e2e.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hippo/db": "workspace:*",
    "@hippo/shared": "workspace:*",
    "@hippo/rbac": "workspace:*",
    "@hippo/notifications": "workspace:*",
    "@hippo/ai": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "class-validator": "^0.14.1",
    "class-transformer": "^0.5.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "vitest": "^2.1.8"
  }
}
